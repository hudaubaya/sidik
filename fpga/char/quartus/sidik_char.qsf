# DE10-Nano (Cyclone V SE 5CSEBA6U23I7) RO-PUF characterization project.
# Build: ./build.sh (see docs/char_howto.md). Not yet compiled by anyone on
# this repository: check the "Ignored Assignments" report after the first
# compile.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY sidik_char_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

set_global_assignment -name VERILOG_FILE sidik_char_top.v
set_global_assignment -name QIP_FILE char_sys/synthesis/char_sys.qip
set_global_assignment -name SDC_FILE sidik_char.sdc

# ---------------------------------------------------------------------------
# Ring oscillators (combinational loops)
#
# Quartus accepts combinational loops; it warns "Found combinational loop"
# for each one (expect 1024 rings of 5 nodes) and the Timing Analyzer cuts
# them. Unlike Vivado there is no switch that "allows" loops. What this
# file must do is keep every ring intact:
#   - CYCLONEV selects the LCELL implementation in rtl/ro_cell.v: one LUT +
#     one lcell primitive per stage, nets marked synthesis keep.
#   - LCELL buffers must not be ignored, otherwise the rings collapse.
#   - No physical synthesis: it may duplicate, merge or retime the stages.
# ---------------------------------------------------------------------------
set_global_assignment -name VERILOG_MACRO "CYCLONEV=1"
set_global_assignment -name IGNORE_LCELL_BUFFERS OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION OFF
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF

# Synchronizers in rtl/puf_meas.v (RO domains <-> 50 MHz).
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "*u_meas|halted_a_sync[*]"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "*u_meas|halted_b_sync[*]"
set_instance_assignment -name SYNCHRONIZER_IDENTIFICATION "FORCED IF ASYNCHRONOUS" -to "*u_meas|u_cnt_?|stop_sync[*]"

# ---------------------------------------------------------------------------
# LogicLock region: ro_array and puf_meas together.
#
# Starts as auto-sized and floating so the first compile always fits. After
# the first good compile, lock it in Chip Planner (or set LL_AUTO_SIZE OFF,
# LL_STATE LOCKED and copy the fitted LL_ORIGIN / LL_WIDTH / LL_HEIGHT here)
# so every later bitstream uses the same area. Reserved: no other logic is
# placed inside it.
#
# A region keeps the PUF in one area; it does NOT make the two ROs of a pair
# identical. Matched placement per pair needs location assignments per RO,
# see docs/char_howto.md.
# ---------------------------------------------------------------------------
set_global_assignment -name LL_ENABLED ON -section_id ro_region
set_global_assignment -name LL_AUTO_SIZE ON -section_id ro_region
set_global_assignment -name LL_STATE FLOATING -section_id ro_region
set_global_assignment -name LL_RESERVED ON -section_id ro_region
set_global_assignment -name LL_SOFT OFF -section_id ro_region
set_instance_assignment -name LL_MEMBER_OF ro_region -to "*ropuf_core:u_core|ro_array:u_array" -section_id ro_region
set_instance_assignment -name LL_MEMBER_OF ro_region -to "*ropuf_core:u_core|puf_meas:u_meas" -section_id ro_region

# ---------------------------------------------------------------------------
# DE10-Nano pins (Terasic DE10-Nano user manual; verify against the board's
# golden top QSF before programming).
# ---------------------------------------------------------------------------
set_location_assignment PIN_V11 -to FPGA_CLK1_50
set_location_assignment PIN_AH17 -to KEY[0]
set_location_assignment PIN_AH16 -to KEY[1]
set_location_assignment PIN_W15 -to LED[0]
set_location_assignment PIN_AA24 -to LED[1]
set_location_assignment PIN_V16 -to LED[2]
set_location_assignment PIN_V15 -to LED[3]
set_location_assignment PIN_AF26 -to LED[4]
set_location_assignment PIN_AE26 -to LED[5]
set_location_assignment PIN_Y16 -to LED[6]
set_location_assignment PIN_AA23 -to LED[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED[*]
